"""SQLAlchemy engine and request-scoped session infrastructure."""

from collections.abc import Iterator
from contextlib import contextmanager
from typing import Any

from sqlalchemy import Engine, create_engine
from sqlalchemy.orm import Session, sessionmaker
from sqlalchemy.pool import StaticPool

from .config import Settings, get_settings


def create_database_engine(settings: Settings | None = None) -> Engine:
    """Create the application engine from settings.

    The adapter uses a synchronous SQLAlchemy session because the current
    FastAPI domain services are synchronous. SQLite receives a thread-safe
    configuration for tests; PostgreSQL receives connection health checks and
    bounded pooling.
    """

    resolved = settings or get_settings()
    url = resolved.database_url
    engine_options: dict[str, Any] = {
        "future": True,
        "pool_pre_ping": True,
    }

    if url.startswith("sqlite"):
        engine_options["connect_args"] = {"check_same_thread": False}
        if ":memory:" in url:
            # A single connection keeps an in-memory schema available to the
            # TestClient and the session that created it.
            engine_options["poolclass"] = StaticPool
    else:
        engine_options["pool_size"] = resolved.db_pool_size
        engine_options["max_overflow"] = resolved.db_max_overflow

    return create_engine(url, **engine_options)


engine = create_database_engine()
SessionFactory = sessionmaker(
    bind=engine,
    autoflush=False,
    expire_on_commit=False,
    class_=Session,
)


def get_db_session() -> Iterator[Session]:
    """Yield one session per request and roll back failed requests."""

    session = SessionFactory()
    try:
        yield session
    except BaseException:
        session.rollback()
        raise
    finally:
        session.close()


@contextmanager
def session_scope(factory: sessionmaker = SessionFactory) -> Iterator[Session]:
    """Run service work in an explicit transaction and close the session."""

    session = factory()
    try:
        with session.begin():
            yield session
    finally:
        session.close()
"""Employer-owned company profile use cases."""

from __future__ import annotations

from typing import Any
from uuid import uuid4

from fastapi import HTTPException, status
from sqlalchemy import text
from sqlalchemy.orm import Session

from .auth import Principal, sync_identity

COMPANY_FIELDS = (
    "name",
    "description",
    "industry",
    "website",
    "location",
    "public_contact_method",
)


def _ensure_company(db: Session, principal: Principal) -> tuple[str, str]:
    identity = sync_identity(db, principal)
    company_id = db.execute(
        text("SELECT id FROM company WHERE owner_identity_id = :identity_id"),
        {"identity_id": identity["id"]},
    ).scalar_one_or_none()
    if company_id is None:
        company_id = str(uuid4())
        db.execute(
            text("INSERT INTO company (id, owner_identity_id) VALUES (:id, :identity_id)"),
            {"id": company_id, "identity_id": identity["id"]},
        )
        db.commit()
    return identity["id"], company_id


def _company_row(db: Session, company_id: str):
    return db.execute(
        text(
            "SELECT id, name, description, industry, website, location, "
            "public_contact_method, created_at, updated_at FROM company WHERE id = :company_id"
        ),
        {"company_id": company_id},
    ).mappings().one()


def _public_company(row) -> dict[str, Any]:
    return {
        "id": row["id"],
        "name": row["name"],
        "description": row["description"],
        "industry": row["industry"],
        "website": row["website"],
        "location": row["location"],
        "public_contact_method": row["public_contact_method"],
        "created_at": row["created_at"],
        "updated_at": row["updated_at"],
    }


def get_company(db: Session, principal: Principal) -> dict[str, Any]:
    _, company_id = _ensure_company(db, principal)
    return _public_company(_company_row(db, company_id))


def update_company(
    db: Session,
    principal: Principal,
    changes: dict[str, Any],
) -> dict[str, Any]:
    _, company_id = _ensure_company(db, principal)
    current = _company_row(db, company_id)

    next_values = {field: current[field] for field in COMPANY_FIELDS}
    for field, value in changes.items():
        if field in next_values:
            if isinstance(value, str):
                value = value.strip() or None
            next_values[field] = value

    if not next_values["name"]:
        raise HTTPException(status_code=status.HTTP_422_UNPROCESSABLE_ENTITY, detail="company_name_required")

    db.execute(
        text(
            "UPDATE company SET name = :name, description = :description, industry = :industry, "
            "website = :website, location = :location, public_contact_method = :public_contact_method, "
            "updated_at = CURRENT_TIMESTAMP WHERE id = :company_id"
        ),
        {**next_values, "company_id": company_id},
    )
    db.commit()
    return _public_company(_company_row(db, company_id))
"""Read-only taxonomy catalog used by onboarding and later matching modules."""

from __future__ import annotations

from typing import Any

from sqlalchemy import text
from sqlalchemy.orm import Session


def list_taxonomy(db: Session) -> dict[str, Any]:
    """Return the active catalog and explicit specialization/grade categories.

    The query intentionally reads the database rather than importing a Python
    constant. This keeps labels and IDs consistent with future administered
    taxonomy versions and makes the API useful to clients before sign-in.
    """

    specializations: dict[str, dict[str, Any]] = {}
    rows = db.execute(
        text(
            "SELECT s.id AS specialization_id, s.slug AS specialization_slug, "
            "s.name AS specialization_name, sk.id AS skill_id, sk.slug AS skill_slug, "
            "sk.name AS skill_name, ss.is_core "
            "FROM specialization s "
            "LEFT JOIN specialization_skill ss ON ss.specialization_id = s.id "
            "LEFT JOIN skill sk ON sk.id = ss.skill_id AND sk.active = :active "
            "WHERE s.active = :active "
            "ORDER BY s.name, sk.name"
        ),
        {"active": True},
    ).mappings()
    for row in rows:
        specialization = specializations.setdefault(
            row["specialization_slug"],
            {
                "id": row["specialization_id"],
                "slug": row["specialization_slug"],
                "name": row["specialization_name"],
                "skills": [],
            },
        )
        if row["skill_id"] is not None:
            specialization["skills"].append(
                {
                    "id": row["skill_id"],
                    "slug": row["skill_slug"],
                    "name": row["skill_name"],
                    "is_core": bool(row["is_core"]),
                }
            )

    grades = [
        dict(row)
        for row in db.execute(
            text(
                "SELECT id, slug, name, rank FROM grade "
                "ORDER BY rank, name"
            )
        ).mappings()
    ]
    categories = [
        {
            "key": f"{specialization['slug']}:{grade['slug']}",
            "specialization_slug": specialization["slug"],
            "grade_slug": grade["slug"],
            "label": f"{specialization['name']} · {grade['name']}",
        }
        for specialization in specializations.values()
        for grade in grades
    ]
    return {
        "specializations": list(specializations.values()),
        "grades": grades,
        "categories": categories,
    }

