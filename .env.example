COMPOSE_PROJECT_NAME=fsp-platform

FRONTEND_PORT=3000
BACKEND_PORT=8000
KEYCLOAK_PORT=8081
MAILPIT_PORT=8025

POSTGRES_DB=fsp
POSTGRES_USER=fsp
POSTGRES_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB_PASSWORD
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD

KEYCLOAK_REALM=fsp
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_ISSUER=http://localhost:8081/realms/fsp
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/fsp/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=fsp-web
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8081
NEXT_PUBLIC_KEYCLOAK_REALM=fsp
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=fsp-web

DATABASE_URL=postgresql+psycopg://fsp:CHANGE_ME_APP_DB_PASSWORD@app-db:5432/fsp

APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PRIVATE_STORAGE_DIR=/var/lib/fsp/private

# Detailed base-assessment canonical solutions remain hidden until this window
# closes or the item family/version is explicitly retired.
CANONICAL_EXPOSURE_WINDOW_DAYS=90

# Optional LOCAL AI-assisted features only. Core must work without it and without GPU.
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL=http://local-ai:11434
LOCAL_AI_MODEL=
LOCAL_AI_TIMEOUT_SECONDS=60

# External AI is intentionally disabled by default. Do not put candidate PII into external services.
OPENAI_API_KEY=
