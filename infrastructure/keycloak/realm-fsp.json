{
  "realm": "fsp",
  "enabled": true,
  "displayName": "FSP Talent",
  "registrationAllowed": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "id": "00000000-0000-0000-0000-000000000001",
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "config-pieces-count": [
            "1"
          ],
          "config-piece-0": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{}}},{\"name\":\"email\",\"displayName\":\"${email}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"required\":{\"roles\":[\"user\"]},\"validations\":{\"email\":{},\"pattern\":{\"pattern\":\"^[^@\\\\s]+@[^@\\\\s]+\\\\.ru$\"}}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}}}],\"groups\":[]}"
          ]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      {
        "name": "candidate",
        "description": "Candidate user"
      },
      {
        "name": "employer",
        "description": "Employer user"
      }
    ]
  },
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@fsp-talent.local",
    "fromDisplayName": "FSP Talent"
  },
  "clients": [
    {
      "clientId": "fsp-web",
      "name": "FSP Talent Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://127.0.0.1:3000/*",
        "http://frontend:3000/*",
        "http://localhost:3000/*",
        "https://fsp.any1key.ru/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:3000",
        "http://frontend:3000",
        "http://localhost:3000",
        "https://fsp.any1key.ru"
      ],
      "protocolMappers": [
        {
          "name": "fsp-web audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "fsp-web",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ]
}
